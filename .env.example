DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/pointlat
PAYLOAD_SECRET=ganti-dengan-string-acak-minimal-32-karakter
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SEED_ADMIN_EMAIL=admin@point.lat
SEED_ADMIN_PASSWORD=ganti-password-ini
# Cloudinary (hanya server). Kosongkan di lokal/tes: aplikasi memakai klien palsu dalam memori.
# Wajib diisi di produksi (Vercel). Lalu jalankan sekali: pnpm media:siapkan
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Mesin Indexing (hanya server). Lokal dan tes: biarkan kosong, adapter palsu tidak memanggil jaringan.
# Produksi Vercel: INDEXER_ADAPTER=asli, GOOGLE_SERVICE_ACCOUNT_JSON berisi seluruh file kunci JSON akun
# layanan Google, CRON_SECRET acak minimal 16 karakter (Vercel Cron mengirimnya sebagai Bearer). Pratinjau: palsu.
INDEXER_ADAPTER=
GOOGLE_SERVICE_ACCOUNT_JSON=
CRON_SECRET=
# Asisten AI (hanya server). Lokal dan tes: biarkan kosong, adapter palsu menjawab contoh tanpa jaringan.
# Produksi Vercel: AI_ADAPTER=asli dan ANTHROPIC_API_KEY dari Claude Console. Pratinjau: palsu.
# Model opsional: AI_MODEL untuk semua tugas, atau AI_MODEL_BRIEF, AI_MODEL_DRAF, AI_MODEL_META per tugas
# (bawaan: claude-sonnet-5-5 untuk brief dan draf, claude-haiku-5-5 untuk meta). Model baru juga butuh
# harganya di Pengaturan, Asisten AI.
AI_ADAPTER=
ANTHROPIC_API_KEY=
AI_MODEL=
AI_MODEL_BRIEF=
AI_MODEL_DRAF=
AI_MODEL_META=
